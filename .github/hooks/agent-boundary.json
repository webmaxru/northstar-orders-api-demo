{
  "$comment": "Agent Hooks variant: PreToolUse is translated into Responsible AI Agent Hooks pre_tool_call, composed in-process, then translated back to Copilot. This is an explicitly non-conformant partial adapter because Copilot exposes no pre/post-model or main-output interception points and outer hook timeouts remain fail-open. Other lifecycle records remain native Copilot hook records.",
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node scripts/session-start.mjs",
        "timeout": 20
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node scripts/resolve-task.mjs",
        "timeout": 20
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "node scripts/agent-hooks-bridge.mjs",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "node scripts/audit-hook.mjs",
        "timeout": 10
      }
    ],
    "PostToolUseFailure": [
      {
        "type": "command",
        "command": "node scripts/audit-hook.mjs",
        "timeout": 10
      }
    ],
    "SessionEnd": [
      {
        "type": "command",
        "command": "node scripts/audit-hook.mjs",
        "timeout": 10
      }
    ]
  }
}
