{
  "$comment": "CUSTOMIZE the Node invocation only for your installed runtime. PascalCase event names select documented compatibility envelopes, not proof of host parity. Register each event once. Prompt hook output is not a universal stop control; cached authority is cleared on failure and PreToolUse denies writes. Stop dispatch uses the explicit task role. Local hook records are not hosted acceptance evidence.",
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node scripts/session-start.mjs",
        "timeout": 20
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node scripts/resolve-task.mjs",
        "timeout": 20
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "node scripts/authorize-tool.mjs",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "node scripts/audit-hook.mjs",
        "timeout": 10
      }
    ],
    "PostToolUseFailure": [
      {
        "type": "command",
        "command": "node scripts/audit-hook.mjs",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node scripts/stop-dispatch.mjs",
        "timeout": 300
      }
    ],
    "SessionEnd": [
      {
        "type": "command",
        "command": "node scripts/audit-hook.mjs",
        "timeout": 10
      }
    ]
  }
}
