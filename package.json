{
  "name": "northstar-orders-api-demo",
  "version": "1.0.0",
  "description": "Fictional API used to demonstrate governed AI-assisted delivery workflows.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests/unit",
    "test:unit:ci": "node -e \"require('node:fs').mkdirSync('artifacts',{recursive:true})\" && vitest run tests/unit --reporter=default --reporter=junit --outputFile.junit=artifacts/unit-junit.xml",
    "test:acceptance": "vitest run tests/acceptance",
    "test:acceptance:ci": "node -e \"require('node:fs').mkdirSync('artifacts',{recursive:true})\" && vitest run tests/acceptance --reporter=default --reporter=junit --outputFile.junit=artifacts/acceptance-junit.xml",
    "validate": "npm run instructions:check && npm run governance:check && npm run lint && npm run typecheck && npm run build && npm run test:unit",
    "contract:fetch": "node scripts/fetch-task-contract.mjs",
    "contract:from-pr": "node scripts/resolve-pr-task.mjs",
    "plan:show": "node scripts/publish-plan.mjs --show",
    "plan:gate": "node scripts/check-plan.mjs",
    "plan:materialize": "node scripts/plan-contract.mjs",
    "plan:publish": "node scripts/publish-plan.mjs",
    "plan:approved": "node scripts/fetch-approved-plan.mjs",
    "plan:record-approval": "node scripts/plan-approval.mjs",
    "scope:check": "node scripts/check-scope.mjs",
    "merge:check": "node scripts/check-merge.mjs",
    "instructions:sync": "node scripts/sync-agent-instructions.mjs",
    "instructions:check": "node scripts/sync-agent-instructions.mjs --check",
    "governance:check": "node scripts/governance-audit.mjs --offline",
    "governance:online": "node scripts/governance-audit.mjs --out artifacts/repository-controls-report.json",
    "security:secrets": "node scripts/secret-scan.mjs",
    "evidence": "node scripts/build-execution-report.mjs",
    "repair:check": "node scripts/repair-budget.mjs",
    "hook:check": "node scripts/authorize-tool.mjs",
    "agentic:compile": "gh aw compile daily-repository-status --validate --strict --action-mode release --action-tag eed4304d8740f0593f2797276cb8299d228ffd9b --poutine",
    "agentic:zizmor": "node scripts/run-zizmor.mjs",
    "agentic:validate": "npm run agentic:compile && npm run agentic:zizmor",
    "demo:system": "node scripts/system-demo.mjs",
    "validate:all": "npm run validate && npm run test:acceptance && npm audit --audit-level=high && npm run security:secrets && npm run agentic:validate",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down -v"
  },
  "keywords": [
    "github-copilot",
    "agentic-development",
    "idempotency",
    "demo"
  ],
  "author": "Maxim Salnikov",
  "license": "MIT",
  "dependencies": {
    "fastify": "5.12.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "eslint": "^10.8.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "4.1.6"
  }
}
